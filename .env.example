# PostgreSQL
POSTGRES_DB=wdp
POSTGRES_USER=wdp
POSTGRES_PASSWORD=wdp-postgres
DATABASE_URL=postgresql+asyncpg://wdp:wdp-postgres@localhost:5432/wdp

# RabbitMQ
RABBITMQ_USER=wdp
RABBITMQ_PASSWORD=wdp-rabbit
RABBITMQ_URL=amqp://wdp:wdp-rabbit@localhost:5672/

# Security
API_KEY_HASH_SECRET=change_me
ENCRYPTION_KEY=change_me

# Delivery and retries
DELIVERY_TIMEOUT_SECONDS=10
MAX_DELIVERY_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=10

# Logging
LOG_LEVEL=INFO